{
"compilerOptions": {
"target": "ES2022",
"module": "preserve",
"moduleResolution": "bundler",
"esModuleInterop": true,
"strict": true,
"skipLibCheck": true,
"resolveJsonModule": true,
"noEmit": true,
"types": ["node", "@playwright/test"]
},
"include": ["tests/**/*.ts", "Pages/**/*.ts", "test-data/**/*.ts", "playwright.config.ts"]
}